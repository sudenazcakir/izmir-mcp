# Kopyala: cp .env.example .env  (.env asla commit edilmez)

# İzmir Büyükşehir açık veri API (anahtar gerekmiyor)
IZMIR_API_BASE=https://openapi.izmir.bel.tr
ESHOT_API_BASE=https://acikveriwapi.izmir.bel.tr
HTTP_TIMEOUT_SECONDS=8

# Supabase Postgres bağlantısı (Project Settings > Database > Connection string > URI)
# Boş bırakılırsa sunucu veritabanısız, yalnız canlı API ile çalışır.
DATABASE_URL=

# Varış süresi tahmini (ESHOT dakika vermiyor, biz hesaplıyoruz)
AVG_MINUTES_PER_STOP=1.5
AVG_BUS_SPEED_KMH=18

# 2. hafta (Bahar): Upstash Redis
REDIS_URL=

# 3. hafta (Sude): uzak sunucu için API anahtarı doğrulaması
MCP_API_KEY_REQUIRED=false

# Web sohbet sayfası (izmir-mcp-web)
# Anthropic Console > API Keys. Asla commit etme, sohbete yapıştırma.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5
CHAT_EFFORT=low
CHAT_RATE_LIMIT=20
# /mcp ucunu korur (Claude API bu anahtarla bağlanır). Üret: openssl rand -hex 32
MCP_API_KEY=
# Claude API'nin /mcp'ye ulaşacağı herkese açık adres. Render'da boş bırak (RENDER_EXTERNAL_URL kullanılır).
PUBLIC_BASE_URL=
